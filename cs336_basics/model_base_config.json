{
    "model_architecture": {
        "vocab_size": 10000,
        "context_length": 256, 
        "num_layers": 4, 
        "d_model": 512, 
        "num_heads": 16, 
        "d_ff": 1344, 
        "rope_theta": 10000
    }, 
    "model_training": {
        "n_steps": 1000, 
        "batch_size": 64,
        "gradient_accumulation_steps": 4, 
        "n_eval_batches": 4, 
        "eval_every_steps": 5, 
        "optimizer": {
            "betas": [0.9, 0.999],
            "weight_decay": 0.01,
            "eps": 1e-8
        }, 
        "lr_scheduler": {
            "lr_max": 1e-3,
            "lr_min": 1e-5,
            "warmup_iters": 100,
            "cosine_cycle_iters": 700
        }, 
        "grad_clip": {
            "max_l2_norm": 1.0
        }
    }
}